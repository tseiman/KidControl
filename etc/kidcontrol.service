[Unit]
Description=KidControl Apple TV access service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kidcontrol
Group=kidcontrol
UMask=0077
WorkingDirectory=/opt/kidcontrol/code
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/kidcontrol/code/dist/main.js
EnvironmentFile=/etc/kidcontrol/kidcontrol.env
StandardOutput=append:/var/log/kidcontrol/kidcontrol.log
StandardError=append:/var/log/kidcontrol/kidcontrol_error.log
Restart=on-failure
RestartSec=5s
LogsDirectory=kidcontrol
LogsDirectoryMode=0750
StateDirectory=kidcontrol
StateDirectoryMode=0700
ConfigurationDirectory=kidcontrol
ConfigurationDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Node/V8 requires executable JIT memory; MemoryDenyWriteExecute is incompatible.
CapabilityBoundingSet=
AmbientCapabilities=
# Node os.networkInterfaces() needs AF_NETLINK for mDNS interface discovery.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/kidcontrol

[Install]
WantedBy=multi-user.target
